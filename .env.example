# ===== PostgreSQL =====
POSTGRES_USER=library
POSTGRES_PASSWORD=library_pass
POSTGRES_DB=library_db
POSTGRES_PORT=5432

# ===== RabbitMQ =====
# Luu y: khong dung user 'guest' vi guest chi ket noi duoc tu localhost.
RABBITMQ_USER=library
RABBITMQ_PASSWORD=library_pass
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ===== Ket noi tu Windows (dev) toi ha tang chay trong VM (Bridged) =====
# Thay <VM_IP> bang IP cua may ao Ubuntu.
POSTGRES_HOST=<VM_IP>
RABBITMQ_HOST=<VM_IP>

# ===== URL API cho MVC client khi chay tren Windows =====
LIBRARY_API_BASEURL=http://localhost:8080

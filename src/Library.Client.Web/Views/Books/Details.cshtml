@model Library.Contracts.Dtos.BookDetailDto
@{
    ViewData["Title"] = "Chi tiết sách";
}

<h1>@Model.Title</h1>

<dl class="row">
    <dt class="col-sm-3">Tác giả</dt>
    <dd class="col-sm-9">@Model.Author</dd>

    <dt class="col-sm-3">ISBN</dt>
    <dd class="col-sm-9">@Model.Isbn</dd>

    <dt class="col-sm-3">Thể loại</dt>
    <dd class="col-sm-9">@Model.Category</dd>

    <dt class="col-sm-3">Số bản</dt>
    <dd class="col-sm-9">@Model.AvailableCopies / @Model.TotalCopies còn trống</dd>
</dl>

<h4>Các bản sách</h4>
<table class="table table-sm table-bordered align-middle">
    <thead>
        <tr>
            <th>Mã bản</th>
            <th>Trạng thái</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var copy in Model.Copies)
    {
        <tr>
            <td>@copy.Id</td>
            <td>@copy.Status</td>
        </tr>
    }
    </tbody>
</table>

<a class="btn btn-secondary" asp-action="Index">Quay lại danh sách</a>

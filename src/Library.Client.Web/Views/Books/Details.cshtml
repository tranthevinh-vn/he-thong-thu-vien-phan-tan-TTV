@model Library.Client.Web.Models.BookDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết sách";
    var book = Model.Book;
}

<h1>@book.Title</h1>

<dl class="row">
    <dt class="col-sm-3">Tác giả</dt>
    <dd class="col-sm-9">@book.Author</dd>

    <dt class="col-sm-3">ISBN</dt>
    <dd class="col-sm-9">@book.Isbn</dd>

    <dt class="col-sm-3">Thể loại</dt>
    <dd class="col-sm-9">@book.Category</dd>

    <dt class="col-sm-3">Số bản</dt>
    <dd class="col-sm-9">@book.AvailableCopies / @book.TotalCopies còn trống</dd>
</dl>

@if (book.AvailableCopies > 0)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Đặt mượn sách</h5>
            <form method="post" asp-controller="Reservations" asp-action="Create" class="row g-2 align-items-end">
                <input type="hidden" name="bookId" value="@book.Id" />
                <div class="col-md-5">
                    <label class="form-label" for="userId">Người mượn</label>
                    <select id="userId" name="userId" class="form-select" required>
                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.Id">@user.Name (@user.Email)</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Đặt mượn</button>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Hiện không còn bản sách nào khả dụng để đặt mượn.</div>
}

<h4>Các bản sách</h4>
<table class="table table-sm table-bordered align-middle">
    <thead>
        <tr>
            <th>Mã bản</th>
            <th>Trạng thái</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var copy in book.Copies)
    {
        <tr>
            <td>@copy.Id</td>
            <td>@copy.Status</td>
        </tr>
    }
    </tbody>
</table>

<a class="btn btn-secondary" asp-action="Index">Quay lại danh sách</a>
